# Copy to ops/.env (gitignored). Only the assistant reads this file.

# --- mailbox the assistant reads (IMAP) and sends the brief from (SMTP) ---
# Gmail: create an App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_USER=sudhansu@buzzcaf.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_FOLDER=INBOX
MAIL_SINCE_DAYS=14
# Leave empty to read every mail; or restrict to senders/domains, comma separated
MAIL_WATCH_SENDERS=
# Your CA's addresses so their mail is filed as ca-accounts
MAIL_CA_ADDRESSES=
# Where the morning brief goes (defaults to MAIL_USER)
MAIL_BRIEF_TO=
# Hour (0-23, local) at which --watch sends the brief
BRIEF_HOUR=8

# --- optional: Claude for understanding mail / unclear documents / financial PDFs ---
# Without it everything still works on rules. Set to 0 to force rules even if a key exists.
ANTHROPIC_API_KEY=
BUZZCAF_ASSISTANT_LLM=1
